/*
 * RETrace2 Pipeline Configuration
 */

manifest {
  name = 'RETrace2'
  author = 'Tony Cheng'
  homePage = 'https://github.com/tonypincheng/retrace2'
  description = 'Bioinformatics pipeline for RETrace2 analysis'
  mainScript = 'main.nf'
  nextflowVersion = '24.10.5'
  version = '1.0.0'
}

// Default parameters
params {

  // Configuration profiles
  config_profile_description = 'RETrace2 pipeline profile'
  config_profile_contact = 'Your Email'
  
  // Input parameters
  samplesheet = null

}

// Profiles configuration
profiles {
    // Default profile (when no -profile is specified)
    standard {
        process.executor = 'local'
        docker.enabled = false
        conda.enabled = false
    }
    
    // Container profiles
    docker {
        docker.enabled = true
        conda.enabled = false
        docker.runOptions = '--user $(id -u):$(id -g) --group-add users'
        docker.fixOwnership = true
    }
    
    conda {
        docker.enabled = false
        conda.enabled = true
        conda.channels = 'conda-forge,bioconda,defaults'
        process.conda = "$baseDir/environment.yml"
    }

    local {
        process.executor = 'local'
        docker.enabled = false
        conda.enabled = false
    }
}

// Docker configuration
docker {
    enabled = false
}

// Conda configuration
conda {
    enabled = false
    channels = 'conda-forge,bioconda,defaults'
}

// Process resource configuration
process {
    // Default resources for all processes
    cpus = 1
    memory = 4.GB
    
    // Mapping module resources
    withName: 'FASTQC' {
        cpus = 2
        memory = 4.GB
    }
    
    withName: 'MULTIQC' {
        cpus = 16
        memory = 64.GB
    }
    
    withName: 'TRIM_GALORE' {
        cpus = 8
        memory = 16.GB
    }

        withName: 'BWA_MEM' {
        cpus = 16
        memory = 64.GB
    }
    
    // HipSTR module resources

    
    // Phylo module resources

    
    // Methylation module resources
    withName: 'fastqc' {
        cpus = 2
        memory = 4.GB
    }
    
    withName: 'multiqc' {
        cpus = 16
        memory = 64.GB
    }
    
    withName: 'trim_galore' {
        cpus = 4
        memory = 8.GB
    }
    
    withName: 'methylpy' {
        cpus = 16
        memory = 64.GB
    }
    
    withName: 'analyze_methylpy_stats' {
        cpus = 4
        memory = 8.GB
    }
}


// Ensure that work directories and temporary files are in appropriate locations
workDir = "work"
tmpDir = "$baseDir/tmp" 