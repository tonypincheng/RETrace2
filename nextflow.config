/*
 * RETrace2 Pipeline Configuration
 */

manifest {
  name = 'RETrace2'
  author = 'Tony Cheng'
  homePage = 'https://github.com/tonypincheng/retrace2'
  description = 'Bioinformatics pipeline for RETrace2 analysis'
  mainScript = 'main.nf'
  nextflowVersion = '24.10.5'
  version = '1.0.0'
}

// Default parameters
params {
  // Input/output
  input_dir = 'data/'
  output_dir = 'results/'
  fastq_pattern = '*.fastq'
  
  // Computing resources
  max_memory = '100.GB'
  max_cpus = 30
  
  // Reference genomes
  genomes_base = '/path/to/reference/genomes/'
  genome = 'mm39'
  
  // Tool versions
  versions {
    'fastqc' = '0.12.1'
    'multiqc' = '1.14'
    'trim_galore' = '0.6.10'
    'methylpy' = '1.4.5'
    'python' = '3.9'
  }
  
  // Auto-download reference if not present
  download_reference = false
  
  // Optional analyses
  run_bootstrap = false
  bootstrap_replicates = 100
  run_evaluation = false
  ground_truth = null
  
  // Configuration profiles
  config_profile_description = 'RETrace2 pipeline profile'
  config_profile_contact = 'Your Email'
}

// Set up genomes
params.genomes = [
  'mm39': [
    fasta: "${params.genomes_base}/mm39/genome.fa",
    bwa_index: "${params.genomes_base}/mm39/bwa/"
  ],
  'hg38': [
    fasta: "${params.genomes_base}/hg38/genome.fa",
    bwa_index: "${params.genomes_base}/hg38/bwa/"
  ]
]

// Profiles configuration
profiles {
    // Default profile (when no -profile is specified)
    standard {
        process.executor = 'local'
        docker.enabled = true
        conda.enabled = false
    }
    
    // Container profiles
    docker {
        docker.enabled = true
        conda.enabled = false
        process.container = 'yourusername/retrace2:latest'
    }
    
    conda {
        docker.enabled = false
        conda.enabled = true
        conda.channels = 'conda-forge,bioconda,defaults'
        process.conda = "$baseDir/environment.yml"
    }
    

}

// Docker configuration
docker {
    enabled = true
}

// Conda configuration
conda {
    enabled = true
    channels = 'conda-forge,bioconda,defaults'
}

// Process resource configurations
process {
  // Default resources for all processes
  cpus = 4
  memory = 16.GB
  
  // Process-specific resources
  withName: 'fastqc' {
    cpus = 4
    memory = 8.GB
    container = "quay.io/biocontainers/fastqc:${params.versions.fastqc}"
    conda = "fastqc=${params.versions.fastqc}"
  }
  
  withName: 'multiqc' {
    cpus = 4
    memory = 8.GB
    container = "quay.io/biocontainers/multiqc:${params.versions.multiqc}"
    conda = "multiqc=${params.versions.multiqc}"
  }
  
  withName: 'preprocess' {
    cpus = 4
    memory = 8.GB
    container = "quay.io/biocontainers/trim-galore:${params.versions.trim_galore}"
    conda = "trim-galore=${params.versions.trim_galore}"
  }
  
  withName: 'methylpy' {
    cpus = 8
    memory = 32.GB
    container = "quay.io/biocontainers/methylpy:${params.versions.methylpy}"
    conda = "methylpy=${params.versions.methylpy}"
  }
  
  withName: 'analyze_methylpy_stats' {
    cpus = 4
    memory = 8.GB
    container = "quay.io/biocontainers/python:${params.versions.python}"
    conda = "python=${params.versions.python}"
  }
  
  withName: 'alignment' {
    cpus = 24
    memory = 80.GB
  }
  
  withName: 'call_hipstr' {
    cpus = 16
    memory = 32.GB
  }
  
  withName: 'build_tree' {
    cpus = 8
    memory = 32.GB
  }
  
  // Optional analysis resources
  withName: 'bootstrap_trees' {
    cpus = 8
    memory = 32.GB
  }
  
  withName: 'evaluate_tree' {
    cpus = 4
    memory = 16.GB
  }
}

// Timeline and reporting configuration
timeline {
  enabled = true
  file = "${params.output_dir}/execution_timeline.html"
}

report {
  enabled = true
  file = "${params.output_dir}/execution_report.html"
}

trace {
  enabled = true
  file = "${params.output_dir}/execution_trace.txt"
}

dag {
  enabled = true
  file = "${params.output_dir}/pipeline_dag.svg"
}

// Ensure that work directories and temporary files are in appropriate locations
workDir = "work"
tmpDir = "$baseDir/tmp" 