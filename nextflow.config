/*
 * RETrace2 Pipeline Configuration
 */

manifest {
  name = 'RETrace2'
  author = 'Tony Cheng'
  homePage = 'https://github.com/tonypincheng/retrace2'
  description = 'Bioinformatics pipeline for RETrace2 analysis'
  mainScript = 'main.nf'
  nextflowVersion = '24.10.5'
  version = '1.0.0'
}

// Default parameters
params {
  // Input/output
  input_dir = 'data/'
  output_dir = 'results/'
  fastq_pattern = '*.fastq'
  
  // Computing resources
  max_memory = '100.GB'
  max_cpus = 50
  
  // Reference genomes
  genomes_base = '/path/to/reference/genomes/'
  genome = 'mm39'
    
  // Auto-download reference if not present
  download_reference = false
  
  // Optional analyses
  run_bootstrap = false
  bootstrap_replicates = 100
  run_evaluation = false
  ground_truth = null
  
  // Configuration profiles
  config_profile_description = 'RETrace2 pipeline profile'
  config_profile_contact = 'Your Email'
}

// Set up genomes
params.genomes = [
  'mm39': [
    fasta: "${params.genomes_base}/mm39/genome.fa",
    bwa_index: "${params.genomes_base}/mm39/bwa/"
  ],
  'hg38': [
    fasta: "${params.genomes_base}/hg38/genome.fa",
    bwa_index: "${params.genomes_base}/hg38/bwa/"
  ]
]

// Profiles configuration
profiles {
    // Default profile (when no -profile is specified)
    standard {
        process.executor = 'local'
        docker.enabled = true
        conda.enabled = false
    }
    
    // Container profiles
    docker {
        docker.enabled = true
        conda.enabled = false
    }
    
    conda {
        docker.enabled = false
        conda.enabled = true
        conda.channels = 'conda-forge,bioconda,defaults'
        process.conda = "$baseDir/environment.yml"
    }
}

// Docker configuration
docker {
    enabled = true
}

// Conda configuration
conda {
    enabled = true
    channels = 'conda-forge,bioconda,defaults'
}

// Process resource configuration
process {
    // Default resources for all processes
    cpus = 1
    memory = 4.GB
    
    // Mapping module resources

    
    // HipSTR module resources

    
    // Phylo module resources

    
    // Methylation module resources
    withName: 'fastqc' {
        cpus = 2
        memory = 4.GB
    }
    
    withName: 'multiqc' {
        cpus = 16
        memory = 64.GB
    }
    
    withName: 'preprocess' {
        cpus = 4
        memory = 8.GB
    }
    
    withName: 'methylpy' {
        cpus = 16
        memory = 64.GB
    }
    
    withName: 'analyze_methylpy_stats' {
        cpus = 4
        memory = 8.GB
    }
}


// Ensure that work directories and temporary files are in appropriate locations
workDir = "work"
tmpDir = "$baseDir/tmp" 