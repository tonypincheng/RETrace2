/*
 * RETrace2 Pipeline Configuration
 */

manifest {
  name = 'RETrace2'
  author = 'Tony Cheng'
  homePage = 'https://github.com/tonypincheng/retrace2'
  description = 'Bioinformatics pipeline for RETrace2 analysis'
  mainScript = 'main.nf'
  nextflowVersion = '>=24.04.0'
  version = '1.0.0'
}

// Default parameters
params {
  // Input/output
  input_dir = 'data/'
  output_dir = 'results/'
  fastq_pattern = '*.fastq'
  
  // Computing resources
  max_memory = '100.GB'
  max_cpus = 30
  max_time = '24.h'
  
  // Reference genomes
  genomes_base = '/path/to/reference/genomes/'
  genome = 'mm39'
  
  // Auto-download reference if not present
  download_reference = false
  
  // Optional analyses
  run_bootstrap = false
  bootstrap_replicates = 100
  run_evaluation = false
  ground_truth = null
  
  // Configuration profiles
  config_profile_description = 'RETrace2 pipeline profile'
  config_profile_contact = 'Your Email'
}

// Set up genomes
params.genomes = [
  'mm39': [
    fasta: "${params.genomes_base}/mm39/genome.fa",
    bwa_index: "${params.genomes_base}/mm39/bwa/"
  ],
  'hg38': [
    fasta: "${params.genomes_base}/hg38/genome.fa",
    bwa_index: "${params.genomes_base}/hg38/bwa/"
  ]
]

// Process resource configurations
process {
  // Default resources
  cpus = 4
  memory = 16.GB
  time = 4.h
  
  // Process-specific resources
  withName: 'fastqc' {
    cpus = 4
    memory = 8.GB
  }
  
  withName: 'alignment' {
    cpus = 24
    memory = 80.GB
    time = 12.h
  }
  
  withName: 'call_hipstr' {
    cpus = 16
    memory = 32.GB
    time = 8.h
  }
  
  withName: 'build_tree' {
    cpus = 8
    memory = 32.GB
    time = 6.h
  }
  
  // Optional analysis resources
  withName: 'bootstrap_trees' {
    cpus = 8
    memory = 32.GB
    time = 12.h
  }
  
  withName: 'evaluate_tree' {
    cpus = 4
    memory = 16.GB
    time = 2.h
  }
}

// Execution profiles
profiles {
  standard {
    process.executor = 'local'
  }
  
  docker {
    docker.enabled = true
    process.container = 'yourusername/retrace2:latest'
  }
  
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    process.container = 'library://yourusername/retrace2:latest'
  }
  
  conda {
    conda.enabled = true
    process.conda = "$baseDir/environment.yml"
  }
  
  slurm {
    process.executor = 'slurm'
    process.queue = 'normal'
    process.clusterOptions = '--account=your_account'
  }
  
  // Optional analysis profiles
  bootstrap {
    params.run_bootstrap = true
  }
  
  evaluation {
    params.run_evaluation = true
  }
  
  full {
    params.run_bootstrap = true
    params.run_evaluation = true
  }
}

// Timeline and reporting configuration
timeline {
  enabled = true
  file = "${params.output_dir}/execution_timeline.html"
}

report {
  enabled = true
  file = "${params.output_dir}/execution_report.html"
}

trace {
  enabled = true
  file = "${params.output_dir}/execution_trace.txt"
}

dag {
  enabled = true
  file = "${params.output_dir}/pipeline_dag.svg"
}

// Ensure that work directories and temporary files are in appropriate locations
workDir = "work"
tmpDir = "$baseDir/tmp" 