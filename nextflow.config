/*
 * RETrace2 Pipeline Configuration
 */

manifest {
  name = 'RETrace2'
  author = 'Tony Cheng'
  homePage = 'https://github.com/tonypincheng/retrace2'
  description = 'Bioinformatics pipeline for RETrace2 analysis'
  mainScript = 'main.nf'
  nextflowVersion = '25.04.6'
  version = '1.0.0'
}

// Default parameters
params {

  // Pipeline parameters
  samplesheet = "/path/to/samplesheet"
  output_dir = "results"
  output_prefix = "retrace2_analysis"
  target_bed = "/path/to/target_bed"
  threads = 4
  memory = '16.GB'
  
  // Sequencing parameters
  paired_end = false  // Paired-end currently not supported, false for single-end (default)
  
  // Reference genome parameters
  genome_base = "/path/to/reference/genome_base"
  genome = "mm39"
  ref_fasta = null
  bwa_index_path = null
  
  // Per sample parameters
  min_targets = 100
  min_cpgs = 0
  
  // HipSTR parameters
  hipstr_path = null // Path to HipSTR executable, defaults to "HipSTR" if not specified
  min_qual = 0.9
  min_reads = 10 // Note: this is also used in the STATS module to count targets with min coverage
  max_stutter = 1
  snp_vcf = null
  by_chrom = true // This enable mutiprocessing by chromosome
  
  // Phylogenetic parameters
  dist_metric = 'minComp_EqorNot'
  outgroup = 'Midpoint'
  color_background = true // Set true to color the background instead of the node
  circular_tree = false // Set true to render the tree in circular layout
  random_seed = 42 // Random seed for reproducible phylogenetic tree building

  // Optional analyses flags
  run_bootstrap = false
  bootstrap_iterations = 100
  ground_truth = null
  run_methylation = false
  
  // Methylation parameters
  methylpy_ref = null
  min_reads_per_site = 1
  min_shared_sites = 10
  all_cytosines = false 
  celltype_ref_dir = null // Directory containing reference cell type files in allc format
  celltype_ref_pattern = "*.tsv.gz" // Pattern to match reference files in the directory

  // Infer cell type parameters
  zscore_threshold = -1.2

    // Help flag
  help = false

  // Configuration profiles
  config_profile_description = 'RETrace2 pipeline profile'
  config_profile_contact = 'Your Email'
}

// Profiles configuration
profiles {
    // Default profile (when no -profile is specified)
    standard {
        process.executor = 'local'
        docker.enabled = false
        conda.enabled = false
    }
    
    // Container profiles
    docker {
        docker.enabled = true
        conda.enabled = false
        
        docker.runOptions = '--user $(id -u):$(id -g) --group-add users -v /home:/home -v /opt:/opt -v /data:/data -v /shared:/shared'
        docker.fixOwnership = true
    }
    
    local {
        process.executor = 'local'
        docker.enabled = false
        conda.enabled = false
    }
}

// Docker configuration
docker {
    enabled = false
}



// Process resource configuration
process {
    // Reasonable defaults for most processes
    cpus = 1
    memory = 8.GB
    
    // Ensure Docker gets proper memory limits - fixed syntax
    containerOptions = { "--memory ${task.memory.toString().replaceAll(' ', '').toLowerCase()}" }
    
    // Process-specific resource allocation using withName
    withName: 'FASTQC' {
        cpus = Math.min(params.threads, 4)  // FastQC doesn't benefit from too many threads
        memory = 8.GB
    }
    
    withName: 'MULTIQC' {
        cpus = 1  // MultiQC doesn't benefit from multiple CPUs
        memory = 2.GB
    }
    
    withName: 'TRIM_GALORE' {
        cpus = Math.min(params.threads, 8)  // Trim Galore works well up to 8 threads
        memory = 8.GB
    }

    // Memory-intensive processes with adaptive retry strategy
    withName: 'BWA_MEM' {
        cpus = params.threads
        memory = { MemoryUnit.of(params.memory.toString()) * (1 << (task.attempt - 1)) }
        errorStrategy = { task.exitStatus in [1, 104, 137, 138, 139, 140] ? 'retry' : 'finish' }  // Added 1 for masked OOM
        maxRetries = 3
    }
    
    // HipSTR module resources
    withName: 'HIPSTR_CALLING' {
        cpus = 1
        memory = { MemoryUnit.of(params.memory.toString()) * (1 << (task.attempt - 1)) }
        errorStrategy = { task.exitStatus in [1, 104, 137, 138, 139, 140] ? 'retry' : 'finish' }  // Added 1 for masked OOM
        maxRetries = 3
    }
    
    withName: 'HIPSTR_PER_CHROM' {
        cpus = 1
        memory = { 8.GB * (1 << (task.attempt - 1)) }
        errorStrategy = { task.exitStatus in [1, 104, 137, 138, 139, 140] ? 'retry' : 'finish' }  // Added 1 for masked OOM
        maxRetries = 3
    }
    
    withName: 'HIPSTR:PARSE_VCF' {
        cpus = Math.min(params.threads, 4)
        memory = { MemoryUnit.of(params.memory.toString()) * (1 << (task.attempt - 1)) }
        errorStrategy = { task.exitStatus in [1, 104, 137, 138, 139, 140] ? 'retry' : 'finish' }  // Added 1 for masked OOM
        maxRetries = 3
    }

    
    // Phylo module resources
    withName: 'PHYLO:BUILD_TREE' {
        cpus = params.threads
        memory = { MemoryUnit.of(params.memory.toString()) * 2 * (1 << (task.attempt - 1)) }
        errorStrategy = { task.exitStatus in [1, 104, 137, 138, 139, 140] ? 'retry' : 'finish' }  // Added 1 for masked OOM
        maxRetries = 3
    }
    
    // Stats module resources
    withName: 'COUNT_TARGETS' {
        cpus = Math.min(params.threads, 4)  // I/O bound process
        memory = 8.GB
    }
    
    withName: 'COMBINE_STATS' {
        cpus = Math.min(params.threads, 4)  // I/O bound process
        memory = 8.GB
    }
    
    // Methylation module resources (conditional)
    if (params.run_methylation) {
        withName: 'METH_FASTQC' {
            cpus = Math.min(params.threads, 4)
            memory = 8.GB
        }
        
        withName: 'METH_MULTIQC' {
            cpus = 1
            memory = 2.GB
        }
        
        withName: 'METH_TRIM_GALORE' {
            cpus = Math.min(params.threads, 8)
            memory = 16.GB
        }
        
        withName: 'METHYLPY' {
            cpus = params.threads
            memory = { MemoryUnit.of(params.memory.toString()) * (1 << (task.attempt - 1)) }
            errorStrategy = { task.exitStatus in [1, 104, 137, 138, 139, 140] ? 'retry' : 'finish' }  // Added 1 for masked OOM
            maxRetries = 3
        }
        
        withName: 'INFER_CELLTYPE:CALCULATE_PD_MATRIX' {
            cpus = params.threads
            memory = { 50.GB * (1 << (task.attempt - 1)) }
            errorStrategy = { task.exitStatus in [1, 104, 137, 138, 139, 140] ? 'retry' : 'finish' }  // Added 1 for masked OOM
            maxRetries = 3
        }
    }
}


// Execution tracing for monitoring and debugging memory issues
trace {
    enabled = true
    file = 'execution_trace.txt'  
    fields = 'task_id,name,status,exit,duration,realtime,%cpu,rss,peak_rss'  // Optional: Limit to key fields like memory (rss/peak_rss) to keep files lean
}

// Ensure that work directories and temporary files are in appropriate locations
workDir = "work"
tmpDir = "$baseDir/tmp" 